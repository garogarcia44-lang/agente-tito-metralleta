<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tito.monitor-plans</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/scripts/monitor-auto.mjs</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web</string>

	<!-- Cada 15 min — más seguido que los escaneos (30 min/4h) porque esto vigila
	     dinero ya "en juego" (planes pendiente/activa): conviene notar pronto que
	     tocó objetivo o stop, no solo encontrar candidatos nuevos. El script mismo
	     sale en silencio fuera de horario de mercado. -->
	<key>StartInterval</key>
	<integer>900</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/data/monitor-plans-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/data/monitor-plans-stderr.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
