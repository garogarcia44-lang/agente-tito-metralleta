<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tito.marketsnack-refresh</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/scripts/refresh-marketsnack-cookie.mjs</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web</string>

	<!-- Cada 5 min, pero REACTIVO (ver refresh-marketsnack-cookie.mjs): primero
	     prueba con un GET barato si la cookie actual sigue viva, y solo si está
	     muerta hace el login completo. No es "loguear cada 5 min sí o sí" — es
	     "revisar cada 5 min, relogear solo si hace falta". El script también
	     sale sin hacer nada fuera de horario de mercado (marketHours.mjs), así
	     que de noche/fin de semana/festivos no corre ni el chequeo barato.
	     Antes era cada 1h sin chequeo (loguear siempre) — cambiado 2026-08-15 a
	     pedido de Jorge, para que el peor caso de sesión caída (p. ej. cuando él
	     mismo entra a MarketSnack y patea al bot) baje de 60 min a 5. -->
	<key>StartInterval</key>
	<integer>300</integer>

	<!-- Corre una vez también al cargar el job (p. ej. tras reiniciar el Mac
	     mini o recién instalado), no solo en el primer intervalo. -->
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/data/marketsnack-refresh-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/data/marketsnack-refresh-stderr.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
