<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tito.marketsnack-refresh</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/scripts/refresh-marketsnack-cookie.mjs</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web</string>

	<!-- Cada 1 hora. Antes eran 6h asumiendo que la sesión duraba "de 1 a pocos
	     días" — falso: medido en vivo el 2026-08-13, una cookie refrescada a las
	     5:59 AM ET ya estaba muerta a las 9:47 AM ET (bajo 4 horas). Un margen de
	     1h dado ese dato real. -->
	<key>StartInterval</key>
	<integer>3600</integer>

	<!-- Corre una vez también al cargar el job (p. ej. tras reiniciar el Mac
	     mini o recién instalado), no solo en el primer intervalo. -->
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/data/marketsnack-refresh-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jorge/Downloads/agente-tito-metralleta-main/web/data/marketsnack-refresh-stderr.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
