# Copia este archivo a .env.local y pon tus keys reales.

# Cookie de sesión de app.marketsnack.com. Cubre el flujo (Time & Sales) Y la
# cadena de opciones + info de empresa (option_chain_extended, /api/assets).
# Se refresca sola con scripts/refresh-marketsnack-cookie.mjs (ver
# MARKETSNACK_EMAIL/MARKETSNACK_PASSWORD abajo) — esto queda como respaldo
# manual: DevTools → Network → cualquier request a /api/... → copia el header
# "Cookie" completo.
MARKETSNACK_COOKIE=

# Credenciales de login para el refresco automático de la cookie de arriba
# (scripts/refresh-marketsnack-cookie.mjs, headless con Playwright, corrido
# por launchd cada pocas horas — ver scripts/com.tito.marketsnack-refresh.plist).
# Sin estas dos no se puede refrescar sola; el script falla y hay que seguir
# pegando MARKETSNACK_COOKIE a mano.
MARKETSNACK_EMAIL=
MARKETSNACK_PASSWORD=
# Tope de vencimientos consultados por ticker al pedir la option chain a
# MarketSnack (cada vencimiento es 1 request).
MARKETSNACK_MAX_EXPIRATIONS=20

# API key gratis de finnhub.io — noticias por ticker.
FINNHUB_API_KEY=tu_api_key_de_finnhub

# Token público (publishable) de logo.dev — se usa en el navegador para pedir
# el logo de la empresa directo por ticker, así que va con NEXT_PUBLIC_.
NEXT_PUBLIC_LOGO_DEV_TOKEN=tu_token_publico_de_logo_dev

# Login básico para cuando se expone la app por un túnel público (ver
# middleware.ts). Sin estas dos, la app queda sin protección — así no bloquea
# el desarrollo local por accidente.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Alertas de "Mis Trades" por Telegram. Sin las 2, no se manda nada — la acción
# del plan se completa igual, solo que sin avisar. (Se probó Twilio/WhatsApp
# primero, pero su Content Template Builder está bloqueado en cuentas Trial —
# error 20003 verificado en vivo — así que se cambió a Telegram, gratis sin límite.)
# TELEGRAM_BOT_TOKEN: @BotFather en Telegram → /newbot.
# TELEGRAM_CHAT_ID: el chat_id de la conversación con tu bot (mándale un mensaje
# primero, luego se puede leer con GET https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
